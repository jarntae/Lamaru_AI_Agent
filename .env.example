# Lamaru AI Gateway Configuration

# Gateway Server Settings
LAMARU_HOST=127.0.0.1
LAMARU_PORT=8000
LAMARU_LOG_LEVEL=INFO

# Database Settings
LAMARU_DATABASE_PATH=lamaru.db

# Provider API Keys (Reference pattern: GEMINI_API_KEY_<ID>)
# Add your keys here without committing .env to version control
GEMINI_API_KEY_01=your_google_api_key_here
# GEMINI_API_KEY_02=your_second_google_api_key_here
